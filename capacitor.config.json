{
  "appId": "com.shavitcoolfriend.app",
  "appName": "Shavit",
  "webDir": "dist-native",
  "backgroundColor": "#0c1526",
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": ["banner", "sound", "list"]
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0c1526",
      "showSpinner": false,
      "launchFadeOutDuration": 0
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
